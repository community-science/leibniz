{
  "name": "@example-owner/leibniz-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "prepare-console-data": "node scripts/prepareConsoleData.mjs",
    "predev": "npm run prepare-console-data",
